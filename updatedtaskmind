class IndustryManager(private val context: android.content.Context) {
        var currentIndustry = "base"
            private val unlocked = mutableSetOf("base")

                val allIndustries = listOf("medical","mechanics","construction","diy","logistics","warehouses","truckdriver","programmer","cooking","hobbies","dogtrainer","mentalhealth","parenting")

                    fun isUnlocked(ind: String): Boolean = unlocked.contains(ind) || BillingManager.hasPurchased(ind)

                        fun loadAdapter(ind: String): TranslatorAdapter {
                                    if (!isUnlocked(ind) && ind != "base") {
                                                    // paywall HUD triggered in HUDCanvasManager
                                                                return BaseAdapter()
                                    }
                                            return when (ind) {
                                                            "medical" -> MedicalQLoRAAdapter()      // premium
                                                                        "mechanics" -> MechanicsQLoRAAdapter()
                                                                                    "construction" -> ConstructionQLoRAAdapter()
                                                                                                "diy" -> DiyQLoRAAdapter()
                                                                                                            "logistics" -> LogisticsQLoRAAdapter()
                                                                                                                        "warehouses" -> WarehousesQLoRAAdapter()
                                                                                                                                    "truckdriver" -> TruckDriverQLoRAAdapter()
                                                                                                                                                "programmer" -> ProgrammerQLoRAAdapter()
                                                                                                                                                            "cooking" -> CookingQLoRAAdapter()
                                                                                                                                                                        "hobbies" -> HobbiesQLoRAAdapter()
                                                                                                                                                                                    "dogtrainer" -> DogTrainerQLoRAAdapter()
                                                                                                                                                                                                "mentalhealth" -> MentalHealthQLoRAAdapter()
                                                                                                                                                                                                            "parenting" -> ParentingQLoRAAdapter()
                                                                                                                                                                                                                        else -> BaseQLoRAAdapter()
                                            }
                        }

                            fun cycle(dir: Int) {
                                        val idx = allIndustries.indexOf(currentIndustry)
                                                currentIndustry = allIndustries[(idx + dir + allIndustries.size) % allIndustries.size]
                            }

                                fun getTheme(): String = when (currentIndustry) {
                                            "medical" -> "white-on-blue"
                                                    "mechanics", "construction" -> "yellow-on-black"
                                                            "mentalhealth", "parenting" -> "soft-pastel"
                                                                    else -> "green-on-black"
                                }
}package com.taskmind

